<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gamerec.gamerecommend.mapper.RatingTrainMapper">

    <!-- 物理清空训练集（逻辑删除无法满足重新划分的需求） -->
    <delete id="truncate">
        TRUNCATE TABLE rating_train
    </delete>

    <!-- 批量插入训练集（供 MatrixService.splitTrainTest 落库使用） -->
    <insert id="insertBatch" parameterType="java.util.List">
        INSERT INTO rating_train (user_id, game_id, game_name, rating, play_hours, behavior_time, is_valid)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.userId},
                #{item.gameId},
                #{item.gameName},
                #{item.rating},
                #{item.playHours},
                #{item.behaviorTime},
                #{item.isValid}
            )
        </foreach>
    </insert>

</mapper>
