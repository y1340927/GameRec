# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=game_recommend_db
DB_USERNAME=root
DB_PASSWORD=your_password_here

# ===== 应用配置 =====
SERVER_PORT=8080
FRONTEND_PORT=8081

# ===== 推荐算法配置 =====
USER_CF_TOP_K=15
DEFAULT_TOP_N=10
ACTIVITY_DECAY_RATE=0.01

# ===== AI 大模型配置（可选）=====
# 方式一（推荐）：启动系统后在「系统设置 → AI 设置」页面填写 API Key，
#                配置保存到数据库 ai_settings 表，无需改本文件。
# 方式二：通过环境变量注入（优先级低于数据库配置）
# AI_API_KEY=your_bigmodel_api_key_here
